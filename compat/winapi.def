// The Win32 functions Furbtendulator calls that need a host behind them
// (windows, messages, menus, dialogs, GDI, cursor, threads).  One list, four
// uses (define the four macros, include this file):
//   windows.h  declares them;
//   compat.cpp's pack side makes each a forwarder to the executable's copy
//              (mapper packs are DLLs; there is one window system, the host's);
//   compat.cpp's host side exports them to the packs by name;
//   host_cli.cpp makes the W entries inert for furb_cli (0 / NULL / FALSE)
//              and hand-writes the H entries (headless dialogs etc.).
// The GUI (gui/*.cpp) implements every entry for real.
//
//   W(ret, name, params, args)    inert in furb_cli
//   H(ret, name, params, args)    hand-written in furb_cli
//   WR / HR                       the same, and 'hinst' names a module's
//                                 resources: a pack's forwarder passes its own
//                                 resource table (see furb_rc.h)

// ---- windows
W(ATOM, RegisterClassEx, (const WNDCLASSEX *wc), (wc))
W(HWND, CreateWindowEx, (DWORD ex, LPCTSTR cls, LPCTSTR name, DWORD style, int x, int y, int w, int h, HWND parent, HMENU menu, HINSTANCE hi, LPVOID param), (ex, cls, name, style, x, y, w, h, parent, menu, hi, param))
W(BOOL, DestroyWindow, (HWND h), (h))
W(BOOL, ShowWindow, (HWND h, int cmd), (h, cmd))
W(BOOL, UpdateWindow, (HWND h), (h))
W(BOOL, SetWindowPos, (HWND h, HWND after, int x, int y, int cx, int cy, UINT f), (h, after, x, y, cx, cy, f))
W(BOOL, MoveWindow, (HWND h, int x, int y, int cx, int cy, BOOL repaint), (h, x, y, cx, cy, repaint))
W(BOOL, GetWindowRect, (HWND h, RECT *r), (h, r))
H(BOOL, GetClientRect, (HWND h, RECT *r), (h, r))
W(BOOL, AdjustWindowRect, (RECT *r, DWORD style, BOOL menu), (r, style, menu))
W(BOOL, AdjustWindowRectEx, (RECT *r, DWORD style, BOOL menu, DWORD ex), (r, style, menu, ex))
W(BOOL, SetWindowText, (HWND h, LPCTSTR s), (h, s))
W(int, GetWindowText, (HWND h, LPTSTR s, int n), (h, s, n))
H(int, GetWindowTextLength, (HWND h), (h))
W(LONG, SetWindowLong, (HWND h, int i, LONG v), (h, i, v))
W(LONG, GetWindowLong, (HWND h, int i), (h, i))
W(LONG_PTR, SetWindowLongPtr, (HWND h, int i, LONG_PTR v), (h, i, v))
W(LONG_PTR, GetWindowLongPtr, (HWND h, int i), (h, i))
W(BOOL, InvalidateRect, (HWND h, const RECT *r, BOOL erase), (h, r, erase))
W(BOOL, RedrawWindow, (HWND h, const RECT *r, HRGN rgn, UINT f), (h, r, rgn, f))
W(BOOL, IsWindow, (HWND h), (h))
W(BOOL, IsWindowVisible, (HWND h), (h))
W(BOOL, IsIconic, (HWND h), (h))
W(BOOL, IsZoomed, (HWND h), (h))
W(HWND, SetFocus, (HWND h), (h))
W(HWND, GetFocus, (void), ())
W(BOOL, SetForegroundWindow, (HWND h), (h))
W(HWND, GetForegroundWindow, (void), ())
W(HWND, GetActiveWindow, (void), ())
W(HWND, SetActiveWindow, (HWND h), (h))
